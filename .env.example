# Copy to .env.local. Never commit .env.local.
# Public application configuration. Never put a server Auth key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep true for the non-commercial portfolio, at build AND runtime.
# Retains test-data notice/noindex. Does not change hosting access protection.
ATELIER_PROTOTYPE_MODE=true

# Enable at build AND runtime only with migration14 and the database's
# synthetic_test_enabled=true + live_bookings_enabled=true on the TEST project.
# Matching Cairo/day/advance settings are also required. Default is closed.
NEXT_PUBLIC_FUNCTIONAL_PORTFOLIO=false

# SERVER ONLY, optional for admin-created synthetic employee Auth accounts.
# Set only on the TEST server's private environment. Never NEXT_PUBLIC, never
# commit a value. Missing leaves creation closed; employee status edits remain.
# This is the Supabase Auth-admin secret for NEXT_PUBLIC_SUPABASE_URL's project.
SUPABASE_SECRET_KEY=
