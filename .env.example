# Copy to .env.local. Never commit .env.local.
# These two values are public application configuration, not service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set true for the owner's non-operational prototype. Set at build AND runtime.
# This adds a persistent warning and blocks booking/payment server actions.
# Keep settings.live_bookings_enabled=false too. Do not enter real customer data.
ATELIER_PROTOTYPE_MODE=true
